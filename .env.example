# --- Supabase (database) ---
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Email notifications (Resend) ---
# https://resend.com → API Keys. Optional: if unset, submissions still save.
RESEND_API_KEY=re_your_key
CONTACT_TO_EMAIL=victorv3925@gmail.com
# Use onboarding@resend.dev until you verify your own domain in Resend.
CONTACT_FROM_EMAIL=onboarding@resend.dev

# --- Admin page gate ---
# Visit /admin?key=THIS_VALUE to view submissions.
ADMIN_KEY=choose-a-long-random-string
